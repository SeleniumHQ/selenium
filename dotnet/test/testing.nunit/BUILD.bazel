load("//dotnet:defs.bzl", "csharp_library", "nuget_package")

csharp_library(
    name = "testing.nunit",
    testonly = True,
    srcs = glob(
        ["**/*.cs"],
        exclude = [
            "bin/**",
            "obj/**",
        ],
    ),
    out = "Testing.NUnit",
    data = [
        "appconfig.json",
        "//dotnet/src/webdriver:manager-linux-arm64",
        "//dotnet/src/webdriver:manager-linux-x86_64",
        "//dotnet/src/webdriver:manager-macos",
        "//dotnet/src/webdriver:manager-windows",
    ],
    project_sdk = "web",
    target_frameworks = ["net10.0"],
    visibility = [
        "//dotnet/test:__subpackages__",
    ],
    deps = [
        "//dotnet/src/webdriver:webdriver-net8.0",
        "//dotnet/test/testing.webserver",
        nuget_package("NUnit"),
        nuget_package("NUnit.Analyzers"),
        nuget_package("Runfiles"),
    ],
)
