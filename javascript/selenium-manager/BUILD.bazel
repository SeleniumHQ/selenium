load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load(":version.bzl", "SM_VERSION")

genrule(
    name = "license",
    srcs = ["//:license"],
    outs = [
        "LICENSE",
        "NOTICE",
    ],
    cmd = "cp $(locations //:license) $(@D)",
)

npm_package(
    name = "selenium-manager",
    srcs = [
        "README.md",
        "bin/selenium-manager.js",
        "index.js",
        "package.json",
        ":license",
    ],
    package = "@selenium/manager",
    publishable = True,
    tags = ["release-artifact"],
    version = SM_VERSION,
    visibility = ["//visibility:public"],
)

js_test(
    name = "unit",
    size = "small",
    data = ["index.js"],
    entry_point = "test/index_test.js",
)
