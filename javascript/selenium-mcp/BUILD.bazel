load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@aspect_bazel_lib//lib:jq.bzl", "jq")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//javascript/selenium-mcp:eslint/package_json.bzl", eslint_bin = "bin")
load("@npm//javascript/selenium-webdriver:prettier/package_json.bzl", prettier_bin = "bin")
load("//:version.bzl", "VERSIONS")
load("//common:browsers.bzl", "COMMON_TAGS")
load("//javascript:defs.bzl", "mocha_test")
load("//javascript/private:browsers.bzl", "BROWSERS")

npm_link_all_packages(name = "node_modules")

VERSION = VERSIONS["javascript"]

js_library(
    name = "prod-src-files",
    srcs = glob([
        "bin/*.js",
        "lib/**/*.js",
    ]),
    deps = [
        ":node_modules/@modelcontextprotocol/sdk",
        ":node_modules/zod",
    ],
)

# The server and the bindings release together at the same version, and the
# published package depends on exactly that bindings version. In the workspace
# the bindings come from //:node_modules/selenium-webdriver (HEAD) instead, so
# package.json leaves the dependency out and the stamp adds it.
jq(
    name = "package-json-stamped",
    srcs = ["package.json"],
    out = "stamped/package.json",
    filter = '.version = "%s" | .dependencies["selenium-webdriver"] = "%s"' % (VERSION, VERSION),
)

genrule(
    name = "license",
    srcs = ["//:license"],
    outs = [
        "LICENSE",
        "NOTICE",
    ],
    cmd = "cp $(locations //:license) $(@D)",
)

npm_package(
    name = "selenium-mcp",
    srcs = [
        "README.md",
        ":license",
        ":prod-src-files",
    ] + select({
        "//common:stamp": [":package-json-stamped"],
        "//conditions:default": ["package.json"],
    }),
    package = "@selenium/mcp",
    publishable = True,
    replace_prefixes = {"stamped/": ""},
    tags = [
        "release-artifact",
    ],
    visibility = ["//visibility:public"],
)

js_library(
    name = "package-json",
    srcs = ["package.json"],
)

js_library(
    name = "test-files",
    testonly = True,
    srcs = glob([
        "test/**/*.js",
        "test/fixtures/**",
    ]),
)

mocha_test(
    name = "small-tests",
    size = "small",
    args = ["test/unit/*_test.js"],
    chdir = package_name(),
    data = [
        ":node_modules/mocha",
        ":node_modules/mocha-junit-reporter",
        ":package-json",
        ":prod-src-files",
        ":test-files",
        "//:node_modules/selenium-webdriver",
    ],
    tags = ["unit"],
)

# Chrome only for v0; the other browsers join as the server supports them.
E2E_BROWSERS = ["chrome"]

[
    mocha_test(
        name = "e2e-tests-%s" % browser,
        size = "large",
        args = [
            "--retries",
            "1",
            "test/e2e/*_test.js",
        ],
        chdir = package_name(),
        data = BROWSERS[browser]["data"] + [
            ":node_modules/@bazel/runfiles",
            ":node_modules/mocha",
            ":node_modules/mocha-junit-reporter",
            ":package-json",
            ":prod-src-files",
            ":test-files",
            "//:node_modules/selenium-webdriver",
            "//common/src/web:js-lib",
        ],
        env = {
            "SELENIUM_BROWSER": browser,
        } | BROWSERS[browser]["env"],
        tags = [browser] + COMMON_TAGS,
    )
    for browser in E2E_BROWSERS
]

copy_to_bin(
    name = "eslint-config",
    srcs = ["eslint.config.js"],
)

eslint_bin.eslint_test(
    name = "eslint-test",
    args = ["."],
    chdir = package_name(),
    data = [
        ":eslint-config",
        ":node_modules/@bazel/runfiles",
        ":node_modules/@eslint/js",
        ":node_modules/eslint-plugin-mocha",
        ":node_modules/eslint-plugin-n",
        ":node_modules/eslint-plugin-no-only-tests",
        ":node_modules/eslint-plugin-prettier",
        ":node_modules/globals",
        ":node_modules/mocha",
        ":package-json",
        # eslint-plugin-prettier reads the same config as prettier-test.
        ":prettier-config",
        ":prod-src-files",
        ":test-files",
        "//:node_modules/selenium-webdriver",
    ],
    tags = [
        "lint",
        "skip-rbe",
    ],
)

copy_to_bin(
    name = "prettier-config",
    srcs = [
        ".prettierignore",
        ".prettierrc",
    ],
)

prettier_bin.prettier_test(
    name = "prettier-test",
    args = [
        ".",
        "--check",
        "--ignore-unknown",
        "--config=.prettierrc",
    ],
    chdir = package_name(),
    data = [
        ":package-json",
        ":prettier-config",
        ":prod-src-files",
        ":test-files",
    ],
    tags = ["lint"],
)
