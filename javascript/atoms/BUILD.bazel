# ============================================================================
# TypeScript Migration Infrastructure
# ============================================================================
# This section contains the rules for compiling TypeScript implementations
# and generating Closure-compatible shims to maintain test compatibility
# during the migration from Closure to TypeScript.
#
# Each TypeScript file gets its own ts_project target. TS targets can depend
# on other TS targets via deps. Closure targets depend on the generated shims.

# Shim generator tool
js_binary(
    name = "shim_generator",
    entry_point = "scripts/generate-shim.js",
)

# ----------------------------------------------------------------------------
# bot.ts - Core bot module (no TS dependencies)
# ----------------------------------------------------------------------------
ts_project(
    name = "bot_ts",
    srcs = ["bot.ts"],
    declaration = True,
    declaration_map = True,
    out_dir = "dist",
    resolve_json_module = True,
    source_map = True,
    tsconfig = "tsconfig.json",
)

js_run_binary(
    name = "generate_bot_shim",
    srcs = [
        "bot.ts",
        "dist/bot.js",
    ],
    args = [
        "$(location bot.ts)",
        "bot",
        "$(location dist/bot.js)",
    ],
    stdout = "bot.js",
    tool = ":shim_generator",
)

# ----------------------------------------------------------------------------
# error.ts + response.ts - Error handling (response depends on error)
# These are compiled together since response.ts imports from error.ts
# ----------------------------------------------------------------------------
ts_project(
    name = "errors_ts",
    srcs = [
        "error.ts",
        "response.ts",
    ],
    declaration = True,
    declaration_map = True,
    out_dir = "dist",
    resolve_json_module = True,
    source_map = True,
    tsconfig = "tsconfig.json",
)

js_run_binary(
    name = "generate_error_shim",
    srcs = [
        "dist/error.js",
        "error.ts",
    ],
    args = [
        "$(location error.ts)",
        "bot",
        "$(location dist/error.js)",
    ],
    stdout = "error.js",
    tool = ":shim_generator",
)

js_run_binary(
    name = "generate_response_shim",
    srcs = [
        "dist/response.js",
        "response.ts",
    ],
    args = [
        "$(location response.ts)",
        "bot.response",
        "$(location dist/response.js)",
    ],
    stdout = "response.js",
    tool = ":shim_generator",
)

# ----------------------------------------------------------------------------
# color.ts - Color utilities (no TS dependencies)
# ----------------------------------------------------------------------------
ts_project(
    name = "color_ts",
    srcs = ["color.ts"],
    declaration = True,
    declaration_map = True,
    out_dir = "dist",
    resolve_json_module = True,
    source_map = True,
    tsconfig = "tsconfig.json",
)

js_run_binary(
    name = "generate_color_shim",
    srcs = [
        "color.ts",
        "dist/color.js",
    ],
    args = [
        "$(location color.ts)",
        "bot.color",
        "$(location dist/color.js)",
    ],
    stdout = "color.js",
    tool = ":shim_generator",
)

# ----------------------------------------------------------------------------
# userAgent.ts - User agent detection (uses inlined ua-parser-js patterns, MIT licensed)
# Note: We inline the detection patterns rather than bundling the npm package
# because Closure Compiler cannot process esbuild's bundle format.
# ----------------------------------------------------------------------------
ts_project(
    name = "userAgent_ts",
    srcs = ["userAgent.ts"],
    declaration = True,
    declaration_map = True,
    out_dir = "dist",
    resolve_json_module = True,
    source_map = True,
    tsconfig = "tsconfig.json",
)

js_run_binary(
    name = "generate_userAgent_shim",
    srcs = [
        "dist/userAgent.js",
        "userAgent.ts",
    ],
    args = [
        "$(location userAgent.ts)",
        "bot.userAgent",
        "$(location dist/userAgent.js)",
    ],
    stdout = "userAgent.js",
    tool = ":shim_generator",
)
