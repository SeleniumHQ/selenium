load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")

ts_project(
    name = "inject",
    srcs = ["inject.ts"],
    declaration = True,
    declaration_map = True,
    resolve_json_module = True,
    source_map = True,
    tsconfig = "tsconfig.json",
    deps = [
        "//javascript/atoms-ts/src:inject",
        "//javascript/atoms-ts/src:json",
        "//javascript/atoms-ts/src:response",
    ],
    visibility = ["//visibility:public"],
)

ts_project(
    name = "attribute",
    srcs = ["attribute.ts"],
    declaration = True,
    declaration_map = True,
    resolve_json_module = True,
    source_map = True,
    tsconfig = "tsconfig.json",
    deps = [
        "//javascript/atoms-ts/src:dom",
    ],
    visibility = [
        "//javascript/webdriver-atoms-ts:__subpackages__",
        "//dotnet/src/webdriver:__pkg__",
        "//java/src/org/openqa/selenium/remote:__pkg__",
        "//javascript/chrome-driver:__pkg__",
        "//javascript/ie-driver:__pkg__",
        "//javascript/selenium-webdriver/lib/atoms:__pkg__",
        "//py:__pkg__",
        "//rb/lib/selenium/webdriver/atoms:__pkg__",
    ],
)

genrule(
    name = "attribute_minified",
    srcs = [":attribute"],
    outs = ["attribute_minified.js"],
    cmd = "cat $(SRCS) | grep -v '^import ' | grep -v '^export ' > $@",
    visibility = ["//visibility:public"],
)

esbuild(
    name = "get_attribute_bundle",
    srcs = glob(["*.ts", "inject/*.ts"]),
    bundle = True,
    deps = [
        "//javascript/atoms-ts/src:dom",
    ],
    entry_point = "get-attribute-wrapper.ts",
    format = "iife",
    minify = True,
    platform = "browser",
    target = "es2020",
    visibility = ["//visibility:public"],
)

esbuild(
    name = "is_displayed_bundle",
    srcs = glob(["*.ts", "inject/*.ts"]),
    bundle = True,
    deps = [
        "//javascript/atoms-ts/src:dom",
    ],
    entry_point = "is-displayed-wrapper.ts",
    format = "iife",
    minify = True,
    platform = "browser",
    target = "es2020",
    visibility = ["//visibility:public"],
)

esbuild(
    name = "find_element_bundle",
    srcs = glob(["*.ts", "inject/*.ts", "locators/*.ts", "locators/**/*.ts"]),
    bundle = True,
    entry_point = "find-element-wrapper.ts",
    format = "iife",
    minify = True,
    platform = "browser",
    target = "es2020",
    visibility = ["//visibility:public"],
)

esbuild(
    name = "attribute_bundle",
    srcs = [":attribute"] + glob(["*.ts"]),
    bundle = True,
    entry_point = "attribute-wrapper.ts",
    format = "esm",
    minify = True,
    platform = "browser",
    target = "es2020",
    visibility = ["//visibility:public"],
)

ts_project(
    name = "element",
    srcs = ["element.ts"],
    declaration = True,
    declaration_map = True,
    resolve_json_module = True,
    source_map = True,
    tsconfig = "tsconfig.json",
    deps = [
        ":attribute",
        "//javascript/atoms-ts/src:action",
        "//javascript/atoms-ts/src:bot",
        "//javascript/atoms-ts/src:dom",
        "//javascript/atoms-ts/src:keyboard",
    ],
    visibility = ["//visibility:public"],
)

ts_project(
    name = "inputs",
    srcs = ["inputs.ts"],
    declaration = True,
    declaration_map = True,
    resolve_json_module = True,
    source_map = True,
    tsconfig = "tsconfig.json",
    deps = [
        ":element",
        "//javascript/atoms-ts/src:action",
        "//javascript/atoms-ts/src:bot",
        "//javascript/atoms-ts/src:dom",
        "//javascript/atoms-ts/src:keyboard",
        "//javascript/atoms-ts/src:mouse",
    ],
    visibility = ["//visibility:public"],
)

ts_project(
    name = "execute_script",
    srcs = ["inject/execute_script.ts"],
    declaration = True,
    declaration_map = True,
    resolve_json_module = True,
    source_map = True,
    tsconfig = "tsconfig.json",
    deps = [
        ":inject",
    ],
    visibility = ["//visibility:public"],
)

ts_project(
    name = "action",
    srcs = ["inject/action.ts"],
    declaration = True,
    declaration_map = True,
    resolve_json_module = True,
    source_map = True,
    tsconfig = "tsconfig.json",
    deps = [
        ":execute_script",
    ],
    visibility = ["//visibility:public"],
)

ts_project(
    name = "dom",
    srcs = ["inject/dom.ts"],
    declaration = True,
    declaration_map = True,
    resolve_json_module = True,
    source_map = True,
    tsconfig = "tsconfig.json",
    deps = [
        ":execute_script",
    ],
    visibility = ["//visibility:public"],
)

ts_project(
    name = "find_element",
    srcs = ["inject/find_element.ts"],
    declaration = True,
    declaration_map = True,
    resolve_json_module = True,
    source_map = True,
    tsconfig = "tsconfig.json",
    deps = [
        ":execute_script",
    ],
    visibility = ["//visibility:public"],
)

ts_project(
    name = "frame",
    srcs = ["inject/frame.ts"],
    declaration = True,
    declaration_map = True,
    resolve_json_module = True,
    source_map = True,
    tsconfig = "tsconfig.json",
    deps = [
        ":execute_script",
    ],
    visibility = ["//visibility:public"],
)

ts_project(
    name = "locators",
    srcs = glob([
        "locators/**/*.ts",
    ]),
    declaration = True,
    declaration_map = True,
    resolve_json_module = True,
    source_map = True,
    tsconfig = "tsconfig.json",
    visibility = ["//visibility:public"],
)

ts_project(
    name = "exports",
    srcs = ["exports/index.ts"],
    declaration = True,
    declaration_map = True,
    resolve_json_module = True,
    source_map = True,
    tsconfig = "tsconfig.json",
    deps = [
        ":inject",
        ":attribute",
        ":element",
        ":inputs",
        ":execute_script",
        ":action",
        ":dom",
        ":find_element",
        ":frame",
        ":locators",
    ],
    visibility = ["//visibility:public"],
)

# Aggregated targets for Phase 1, Phase 2, Phase 3, Phase 4, Phase 5, and Phase 6
filegroup(
    name = "all",
    srcs = [
        ":inject",
        ":attribute",
        ":element",
        ":inputs",
        ":execute_script",
        ":action",
        ":dom",
        ":find_element",
        ":frame",
        ":locators",
        ":exports",
    ],
    visibility = ["//visibility:public"],
)
