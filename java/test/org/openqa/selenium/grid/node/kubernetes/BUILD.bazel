load("//java:defs.bzl", "JUNIT5_DEPS", "artifact", "java_test_suite")
load("//java:version.bzl", "TOOLS_JAVA_VERSION")

java_test_suite(
    name = "small-tests",
    size = "small",
    srcs = glob(
        ["*Test.java"],
        exclude = ["KubernetesEmbeddedWithoutFabric8Test.java"],
    ),
    javacopts = [
        "--release",
        TOOLS_JAVA_VERSION,
    ],
    deps = [
        "//java/src/org/openqa/selenium/grid/config",
        "//java/src/org/openqa/selenium/grid/node/kubernetes",
        "//java/src/org/openqa/selenium/remote",
        artifact("io.fabric8:kubernetes-client-api"),
        artifact("io.fabric8:kubernetes-model-batch"),
        artifact("io.fabric8:kubernetes-model-core"),
        artifact("org.junit.jupiter:junit-jupiter-api"),
        artifact("org.assertj:assertj-core"),
        artifact("org.mockito:mockito-core"),
        artifact("org.jspecify:jspecify"),
    ] + JUNIT5_DEPS,
)

# Runs against :kubernetes-embedded with no fabric8 on the runtime classpath, exercising the
# embedded-classes + external-fabric8 deployment mode. Deliberately has no fabric8 deps.
java_test_suite(
    name = "embedded-no-fabric8-tests",
    size = "small",
    srcs = ["KubernetesEmbeddedWithoutFabric8Test.java"],
    javacopts = [
        "--release",
        TOOLS_JAVA_VERSION,
    ],
    deps = [
        "//java/src/org/openqa/selenium/grid/config",
        "//java/src/org/openqa/selenium/grid/node",
        "//java/src/org/openqa/selenium/grid/node/kubernetes:kubernetes-embedded",
        "//java/src/org/openqa/selenium/remote",
        artifact("org.assertj:assertj-core"),
        artifact("org.junit.jupiter:junit-jupiter-api"),
    ] + JUNIT5_DEPS,
)
