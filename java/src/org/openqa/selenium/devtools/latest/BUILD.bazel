load("@rules_jvm_external//:defs.bzl", "artifact")
load("//common:defs.bzl", "copy_file")
load("//java:defs.bzl", "java_export", "java_library")
load("//java:version.bzl", "SE_VERSION")
load("//java/src/org/openqa/selenium/devtools:versions.bzl", "LATEST_CDP_VERSION")

# Publishes the most recent supported CDP version under the stable
# `org.openqa.selenium.devtools.latest` package, so downstream consumers can
# depend on a single coordinate that always tracks the newest CDP release
# instead of bumping their pom each time Chrome ships a new major version.
cdp_version = "latest"

java_export(
    name = cdp_version,
    srcs = [":create-shim-srcs"],
    maven_coordinates = "org.seleniumhq.selenium:selenium-devtools-%s:%s" % (cdp_version, SE_VERSION),
    opens_to = [
        "org.seleniumhq.selenium.json",
    ],
    pom_template = "//java/src/org/openqa/selenium:template-pom",
    tags = [
        "release-artifact",
    ],
    visibility = [
        "//visibility:public",
    ],
    exports = [
        ":cdp",
    ],
    deps = [
        ":cdp",
        "//java:auto-service",
        "//java/src/org/openqa/selenium:core",
        "//java/src/org/openqa/selenium/json",
        "//java/src/org/openqa/selenium/remote",
        artifact("org.jspecify:jspecify"),
    ],
)

java_library(
    name = "cdp",
    srcs = [
        ":create-cdp-srcs",
    ],
    tags = [
        "no-lint",
    ],
    deps = [
        "//java/src/org/openqa/selenium:core",
        "//java/src/org/openqa/selenium/json",
        "//java/src/org/openqa/selenium/remote",
        artifact("org.jspecify:jspecify"),
    ],
)

genrule(
    name = "create-cdp-srcs",
    srcs = [
        ":browser_protocol",
        ":js_protocol",
    ],
    outs = ["cdp.srcjar"],
    cmd = "$(location //java/src/org/openqa/selenium/devtools:cdp-client-generator) $(location :browser_protocol) $(location :js_protocol) %s $@" % cdp_version,
    tools = [
        "//java/src/org/openqa/selenium/devtools:cdp-client-generator",
    ],
)

copy_file(
    name = "browser_protocol",
    src = "//common/devtools/chromium/%s:browser_protocol" % LATEST_CDP_VERSION,
    out = "browser_protocol.json",
)

copy_file(
    name = "js_protocol",
    src = "//common/devtools/chromium/%s:js_protocol" % LATEST_CDP_VERSION,
    out = "js_protocol.json",
)

# Derives the hand-written shim classes for the "latest" alias by rewriting
# every occurrence of the latest CDP version slug (e.g. "v148") to "latest"
# in the corresponding files from that version's package. This keeps the
# alias in lockstep with the newest version without any source duplication.
genrule(
    name = "create-shim-srcs",
    srcs = ["//java/src/org/openqa/selenium/devtools/%s:shim-sources" % LATEST_CDP_VERSION],
    outs = [
        "latestCdpInfo.java",
        "latestDomains.java",
        "latestEvents.java",
        "latestJavascript.java",
        "latestLog.java",
        "latestNetwork.java",
        "latestTarget.java",
        "package-info.java",
    ],
    cmd = ("for src in $(SRCS); do " +
           "base=$$(basename $$src); " +
           "out=$$(echo $$base | sed -e 's/" + LATEST_CDP_VERSION + "/latest/g'); " +
           "sed -e 's/" + LATEST_CDP_VERSION + "/latest/g' $$src > $(RULEDIR)/$$out; " +
           "done"),
)
