+    # Windows can't execute a `.sh` file directly via CreateProcessW (it
+    # ignores shebangs), so on Windows exec we also emit a `.bat` wrapper
+    # that explicitly invokes the shell on the script and return the
+    # wrapper as the rule's executable. The `.sh` is included as a
+    # companion file so it's available next to the `.bat` at runtime.
+    if shell_path.lower().endswith(".exe"):
+        bat_file = ctx.actions.declare_file(ctx.label.name + ".bat")
+        ctx.actions.write(
+            output = bat_file,
+            content = "\r\n".join([
+                "@echo off",
+                "\"{}\" \"%~dp0{}\" %*".format(shell_path, sh_file.basename),
+                "",
+            ]),
+            is_executable = True,
+        )
+        return DefaultInfo(
+            executable = bat_file,
+            files = depset([bat_file, sh_file]),
+            runfiles = ctx.runfiles(files = [sh_file]),
+        )
+
     return DefaultInfo(
-        executable = ctx.outputs.out,
-        files = depset([ctx.outputs.out]),
+        executable = sh_file,
+        files = depset([sh_file]),
     )
 
