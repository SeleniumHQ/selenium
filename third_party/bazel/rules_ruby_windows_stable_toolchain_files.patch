diff --git a/ruby/private/download/BUILD.tpl b/ruby/private/download/BUILD.tpl
index 14939ef..1d21183 100644
--- a/ruby/private/download/BUILD.tpl
+++ b/ruby/private/download/BUILD.tpl
@@ -28,6 +28,18 @@ filegroup(
