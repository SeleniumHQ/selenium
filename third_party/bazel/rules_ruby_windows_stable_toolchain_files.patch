+        exclude = [
+            "dist/unins*.dat",
+            "dist/msys64/etc/hosts",
+            "dist/msys64/etc/networks",
+            "dist/msys64/etc/protocols",
+            "dist/msys64/etc/services",
+            "dist/msys64/etc/pacman.d/gnupg/**",
+            "dist/msys64/var/**",
+            "dist/msys64/**/etc/pki/ca-trust/extracted/java/**",
+        ],
     ),
 )
 
