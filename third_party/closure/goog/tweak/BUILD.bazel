# DO NOT EDIT -- bazel run //third_party/closure/goog:regenerate -- "$PWD"

load("@io_bazel_rules_closure//closure:defs.bzl", "closure_js_library")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

closure_js_library(
    name = "all_js",
    exports = [
        ":entries",
        ":registry",
        ":tweak",
        ":tweakui",
    ],
)

closure_js_library(
    name = "entries",
    srcs = ["entries.js"],
    lenient = True,
    deps = [
        "//third_party/closure/goog/array",
        "//third_party/closure/goog/asserts",
        "//third_party/closure/goog/log",
        "//third_party/closure/goog/object",
    ],
)

closure_js_library(
    name = "registry",
    srcs = ["registry.js"],
    lenient = True,
    deps = [
        "//third_party/closure/goog/array",
        "//third_party/closure/goog/asserts",
        "//third_party/closure/goog/log",
        "//third_party/closure/goog/string",
        "//third_party/closure/goog/tweak:entries",
        "//third_party/closure/goog/uri:utils",
    ],
)

closure_js_library(
    name = "testhelpers",
    testonly = True,
    srcs = ["testhelpers.js"],
    lenient = True,
    deps = [
        "//third_party/closure/goog/tweak",
        "//third_party/closure/goog/tweak:entries",
        "//third_party/closure/goog/tweak:registry",
    ],
)

closure_js_library(
    name = "tweak",
    srcs = ["tweak.js"],
    lenient = True,
    deps = [
        "//third_party/closure/goog/asserts",
        "//third_party/closure/goog/tweak:entries",
        "//third_party/closure/goog/tweak:registry",
    ],
)

closure_js_library(
    name = "tweakui",
    srcs = ["tweakui.js"],
    lenient = True,
    deps = [
        "//third_party/closure/goog/array",
        "//third_party/closure/goog/asserts",
        "//third_party/closure/goog/dom",
        "//third_party/closure/goog/dom:safe",
        "//third_party/closure/goog/dom:tagname",
        "//third_party/closure/goog/html:safehtml",
        "//third_party/closure/goog/html:safestylesheet",
        "//third_party/closure/goog/object",
        "//third_party/closure/goog/string:const",
        "//third_party/closure/goog/style",
        "//third_party/closure/goog/tweak",
        "//third_party/closure/goog/tweak:entries",
        "//third_party/closure/goog/ui:zippy",
        "//third_party/closure/goog/useragent",
    ],
)
