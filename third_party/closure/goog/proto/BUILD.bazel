# DO NOT EDIT -- bazel run //third_party/closure/goog:regenerate -- "$PWD"

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

load("@rules_python//python:defs.bzl", "py_binary")
load("@io_bazel_rules_closure//closure:defs.bzl", "closure_js_library")

closure_js_library(
    name = "all_js",
    exports = [
        ":proto",
        ":serializer",
    ],
)

closure_js_library(
    name = "proto",
    srcs = ["proto.js"],
    lenient = True,
    deps = ["//third_party/closure/goog/proto:serializer"],
)

closure_js_library(
    name = "serializer",
    srcs = ["serializer.js"],
    lenient = True,
    deps = [
        "//third_party/closure/goog/json",
        "//third_party/closure/goog/string",
    ],
)
