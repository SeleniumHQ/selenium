load("@rules_python//python:defs.bzl", "py_binary")
load("@io_bazel_rules_closure//closure:defs.bzl", "closure_js_library")

closure_js_library(
    name = "all_js",
    exports = [
        ":delegateregistry",
        ":delegates",
    ],
)

