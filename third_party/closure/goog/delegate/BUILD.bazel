    deps = [
        "//third_party/closure/goog/array",
        "//third_party/closure/goog/asserts",
        "//third_party/closure/goog/debug",
    ],
)

closure_js_library(
    name = "delegates",
    srcs = ["delegates.js"],
    lenient = True,
)
