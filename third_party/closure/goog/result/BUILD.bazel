# DO NOT EDIT -- bazel run //third_party/closure/goog:regenerate -- "$PWD"

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

load("@rules_python//python:defs.bzl", "py_binary")
load("@io_bazel_rules_closure//closure:defs.bzl", "closure_js_library")

closure_js_library(
    name = "all_js",
    exports = [
        ":deferredadaptor",
        ":dependentresult",
        ":result_interface",
        ":resultutil",
        ":simpleresult",
    ],
)

closure_js_library(
    name = "deferredadaptor",
    srcs = ["deferredadaptor.js"],
    lenient = True,
    deps = [
        "//third_party/closure/goog/result:result_interface",
        "//third_party/closure/goog/result:resultutil",
        "//third_party/closure/goog/mochikit/async:deferred",
    ],
)

closure_js_library(
    name = "dependentresult",
    srcs = ["dependentresult.js"],
    lenient = True,
    deps = ["//third_party/closure/goog/result:result_interface"],
)

closure_js_library(
    name = "result_interface",
    srcs = ["result_interface.js"],
    lenient = True,
    deps = ["//third_party/closure/goog/promise:thenable"],
)

closure_js_library(
    name = "resultutil",
    srcs = ["resultutil.js"],
    lenient = True,
    deps = [
        "//third_party/closure/goog/array",
        "//third_party/closure/goog/result:dependentresult",
        "//third_party/closure/goog/result:result_interface",
        "//third_party/closure/goog/result:simpleresult",
    ],
)

closure_js_library(
    name = "simpleresult",
    srcs = ["simpleresult.js"],
    lenient = True,
    deps = [
        "//third_party/closure/goog/debug:error",
        "//third_party/closure/goog/promise",
        "//third_party/closure/goog/promise:thenable",
        "//third_party/closure/goog/result:result_interface",
    ],
)
