# DO NOT EDIT -- bazel run //third_party/closure/goog:regenerate -- "$PWD"

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

load("@rules_python//python:defs.bzl", "py_binary")
load("@io_bazel_rules_closure//closure:defs.bzl", "closure_js_library")

closure_js_library(
    name = "all_js",
    exports = [
        ":emailaddress",
        ":format",
        ":htmlprettyprinter",
        ":internationalizedemailaddress",
        ":jsonprettyprinter",
    ],
)

closure_js_library(
    name = "emailaddress",
    srcs = ["emailaddress.js"],
    lenient = True,
    deps = ["//third_party/closure/goog/string"],
)

closure_js_library(
    name = "format",
    srcs = ["format.js"],
    lenient = True,
    deps = [
        "//third_party/closure/goog/i18n:graphemebreak",
        "//third_party/closure/goog/string",
        "//third_party/closure/goog/useragent",
    ],
)

closure_js_library(
    name = "htmlprettyprinter",
    srcs = ["htmlprettyprinter.js"],
    lenient = True,
    deps = [
        "//third_party/closure/goog/dom:tagname",
        "//third_party/closure/goog/object",
        "//third_party/closure/goog/string:stringbuffer",
    ],
)

closure_js_library(
    name = "internationalizedemailaddress",
    srcs = ["internationalizedemailaddress.js"],
    lenient = True,
    deps = [
        "//third_party/closure/goog/format:emailaddress",
        "//third_party/closure/goog/string",
    ],
)

closure_js_library(
    name = "jsonprettyprinter",
    srcs = ["jsonprettyprinter.js"],
    lenient = True,
    deps = [
        "//third_party/closure/goog/html:safehtml",
        "//third_party/closure/goog/json",
        "//third_party/closure/goog/string",
        "//third_party/closure/goog/string:stringformat",
    ],
)
