# DO NOT EDIT -- bazel run //third_party/closure/goog:regenerate -- "$PWD"

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

load("@rules_python//python:defs.bzl", "py_binary")
load("@io_bazel_rules_closure//closure:defs.bzl", "closure_js_library")

closure_js_library(
    name = "all_js",
    exports = [
        ":event",
        ":eventtype",
        ":history",
        ":html5history",
    ],
)

closure_js_library(
    name = "event",
    srcs = ["event.js"],
    lenient = True,
    deps = [
        "//third_party/closure/goog/events:event",
        "//third_party/closure/goog/history:eventtype",
    ],
)

closure_js_library(
    name = "eventtype",
    srcs = ["eventtype.js"],
    lenient = True,
)

closure_js_library(
    name = "history",
    srcs = ["history.js"],
    lenient = True,
    deps = [
        "//third_party/closure/goog/asserts",
        "//third_party/closure/goog/dom",
        "//third_party/closure/goog/dom:inputtype",
        "//third_party/closure/goog/dom:safe",
        "//third_party/closure/goog/events:event",
        "//third_party/closure/goog/events:eventhandler",
        "//third_party/closure/goog/events:eventtarget",
        "//third_party/closure/goog/events:eventtype",
        "//third_party/closure/goog/history:event",
        "//third_party/closure/goog/history:eventtype",
        "//third_party/closure/goog/html:safehtml",
        "//third_party/closure/goog/html:trustedresourceurl",
        "//third_party/closure/goog/html:uncheckedconversions",
        "//third_party/closure/goog/labs/useragent:device",
        "//third_party/closure/goog/memoize",
        "//third_party/closure/goog/string",
        "//third_party/closure/goog/string:const",
        "//third_party/closure/goog/timer",
        "//third_party/closure/goog/useragent",
    ],
)

closure_js_library(
    name = "html5history",
    srcs = ["html5history.js"],
    lenient = True,
    deps = [
        "//third_party/closure/goog/asserts",
        "//third_party/closure/goog/events",
        "//third_party/closure/goog/events:eventtarget",
        "//third_party/closure/goog/events:eventtype",
        "//third_party/closure/goog/history:event",
    ],
)
