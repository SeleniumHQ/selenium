# DO NOT EDIT -- bazel run //third_party/closure/goog:regenerate -- "$PWD"

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

load("@rules_python//python:defs.bzl", "py_binary")
load("@io_bazel_rules_closure//closure:defs.bzl", "closure_js_library")

closure_js_library(
    name = "all_js",
    exports = [
        ":defines",
        ":full",
        ":full_impl",
        ":full_native_impl",
        ":full_types",
        ":lite",
        ":lite_impl",
        ":lite_native_impl",
        ":lite_types",
    ],
)

closure_js_library(
    name = "defines",
    srcs = ["defines.js"],
    lenient = True,
)

closure_js_library(
    name = "full",
    srcs = ["full.js"],
    lenient = True,
    deps = [
        "//third_party/closure/goog/streams:defines",
        "//third_party/closure/goog/streams:full_impl",
        "//third_party/closure/goog/streams:full_native_impl",
        "//third_party/closure/goog/streams:full_types",
    ],
)

closure_js_library(
    name = "full_impl",
    srcs = ["full_impl.js"],
    lenient = True,
    deps = [
        "//third_party/closure/goog/asserts",
        "//third_party/closure/goog/promise:nativeresolver",
        "//third_party/closure/goog/streams:full_types",
        "//third_party/closure/goog/streams:lite_impl",
    ],
)

closure_js_library(
    name = "full_native_impl",
    srcs = ["full_native_impl.js"],
    lenient = True,
    deps = [
        "//third_party/closure/goog/streams:full_types",
        "//third_party/closure/goog/streams:lite_native_impl",
    ],
)

closure_js_library(
    name = "full_types",
    srcs = ["full_types.js"],
    lenient = True,
    deps = ["//third_party/closure/goog/streams:lite_types"],
)

closure_js_library(
    name = "lite",
    srcs = ["lite.js"],
    lenient = True,
    deps = [
        "//third_party/closure/goog/streams:defines",
        "//third_party/closure/goog/streams:lite_impl",
        "//third_party/closure/goog/streams:lite_native_impl",
        "//third_party/closure/goog/streams:lite_types",
    ],
)

closure_js_library(
    name = "lite_impl",
    srcs = ["lite_impl.js"],
    lenient = True,
    deps = [
        "//third_party/closure/goog/asserts",
        "//third_party/closure/goog/promise:nativeresolver",
        "//third_party/closure/goog/streams:lite_types",
    ],
)

closure_js_library(
    name = "lite_native_impl",
    srcs = ["lite_native_impl.js"],
    lenient = True,
    deps = ["//third_party/closure/goog/streams:lite_types"],
)

closure_js_library(
    name = "lite_types",
    srcs = ["lite_types.js"],
    lenient = True,
)
