load("//dotnet:defs.bzl", "csharp_binary")
load("//third_party/dotnet/devtools/src/generator:defs.bzl", "devtools_nuget_package")

csharp_binary(
    name = "generator",
    srcs = glob(["**/*.cs"]),
    nullable = "enable",
    # Used as a tool in our build, so just target one framework
    target_frameworks = ["net8.0"],
    visibility = [
        "//dotnet:__subpackages__",
    ],
    deps = [
        devtools_nuget_package("CommandLineParser"),
        devtools_nuget_package("Handlebars.Net"),
        devtools_nuget_package("Humanizer.Core"),
        devtools_nuget_package("Microsoft.Extensions.DependencyInjection"),
        devtools_nuget_package("Microsoft.Extensions.DependencyInjection.Abstractions"),
    ],
)
