load("@aspect_rules_js//js:defs.bzl", "js_library")

filegroup(
    name = "web",
    srcs = glob([
        "*",
        "**/*",
    ]),
    visibility = [
        "//dotnet/test:__subpackages__",
        "//java/test/org/openqa/selenium:__pkg__",
        "//java/test/org/openqa/selenium/environment:__pkg__",
        "//javascript/atoms:__pkg__",
        "//javascript/selenium-webdriver:__pkg__",
        "//py:__pkg__",
        "//rb/spec:__subpackages__",
    ],
)

js_library(
    name = "js-lib",
    data = [
        ":web",
    ],
    visibility = [
        "//javascript/selenium-webdriver:__subpackages__",
    ],
)

# The accessibility snapshot corpus (ADR 18205), copied into the output tree
# so a js_test in another package can read it from its working directory:
# rules_js copies only its own package's source files there.
js_library(
    name = "accessibility-corpus",
    srcs = glob(["accessibility/**"]),
    visibility = ["//javascript/atoms:__pkg__"],
)
