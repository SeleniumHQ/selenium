load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test", "rustfmt_config")

rustfmt_config(
    name = "enable-rustfmt",
)

# --- Platform Aliases for Selenium Manager ---
# These targets manage local builds vs prebuilt binaries depending on the OS.

[
    alias(
        name = "selenium-manager-%s" % os,
        actual = select({
            "//common:%s" % os: ":selenium-manager",
            "//conditions:default": "@download_sm_%s//file" % os,
        }),
        tags = ["manual"],
        visibility = ["//common/manager:__pkg__"],
    )
    for os in ["windows", "macos", "linux"]
]

filegroup(
    name = "selenium-manager-dev",
    srcs = [
        ":selenium-manager-linux",
        ":selenium-manager-macos",
        ":selenium-manager-windows",
    ],
    tags = ["manual"],
    visibility = ["//common/manager:__subpackages__"],
)

alias(
    name = "rust",
    actual = ":selenium_manager",
    visibility = ["//visibility:public"],
)

# --- Rust Binary & Library Targets ---

# Shared configurations for Rust targets
_COMMON_RUST_ATTRS = {
    "aliases": aliases(),
    "edition": "2024",
    "deps": all_crate_deps(normal = True),
}

rust_binary(
    name = "selenium-manager",
    srcs = ["src/main.rs"],
    version = "0.4.48-nightly",
    visibility = ["//visibility:public"],
    rustc_env = {
        "CARGO_PKG_DESCRIPTION": "Selenium Manager is a CLI tool that automatically manages the browser/driver resources required by Selenium.",
    },
    deps = [":selenium_manager"] + _COMMON_RUST_ATTRS["deps"],
    **{k: v for k, v in _COMMON_RUST_ATTRS.items() if k != "deps"}
)

rust_library(
    name = "selenium_manager",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["main.rs"],
    ),
    compile_data = [
        "src/resources/rules.md",
        "src/resources/skills.md",
    ],
    crate_features = select({
        //common:stamp: [],
        "//conditions:default": ["avoid_stats"],
    }),
    visibility = ["//rust:__subpackages__"],
    **_COMMON_RUST_ATTRS
)

# --- Source Filegroups ---

filegroup(
    name = "selenium_manager_rs_srcs",
    srcs = glob(["src/**/*.rs"]),
)

filegroup(
    name = "selenium_manager_srcs",
    srcs = [
        "Cargo.lock",
        "Cargo.toml",
        "src/resources/rules.md",
        "src/resources/skills.md",
        ":selenium_manager_rs_srcs",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "unit",
    size = "small",
    crate = ":selenium_manager",
    tags = ["no-sandbox"],
    aliases = aliases(),
    edition = "2024",
)
