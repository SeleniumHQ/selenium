load("@bazel_skylib//rules:select_file.bzl", "select_file")
load("@rules_python//python:defs.bzl", "py_library")
load("@rules_python//python:packaging.bzl", "py_wheel")
load("//common:defs.bzl", "copy_file")
load("//py/selenium-manager:version.bzl", "SM_VERSION")

# The binary is 32-bit i686, which Windows runs on x64 via WOW64 and on arm64
# via emulation. pip matches on the wheel tag rather than the binary, though, so
# a `win32`-only wheel would be invisible to the 64-bit interpreters that nearly
# everyone runs; ship the same file under every tag it works on.
WHEEL_PLATFORM_TAGS = {
    "win32": "win32",
    "win-amd64": "win_amd64",
    "win-arm64": "win_arm64",
}

copy_file(
    name = "manager-binary",
    src = "//common/manager:selenium-manager-windows",
    out = "selenium_manager_windows/bin/selenium-manager.exe",
)

py_library(
    name = "lib",
    srcs = ["selenium_manager_windows/__init__.py"],
    data = [":manager-binary"],
    imports = ["."],
)

select_file(
    name = "global-license",
    srcs = "//:license",
    subpath = "LICENSE",
)

select_file(
    name = "global-notice",
    srcs = "//:license",
    subpath = "NOTICE",
)

copy_file(
    name = "license-wheel",
    src = ":global-license",
    out = "selenium_manager_windows-%s.dist-info/LICENSE" % SM_VERSION,
)

copy_file(
    name = "notice-wheel",
    src = ":global-notice",
    out = "selenium_manager_windows-%s.dist-info/NOTICE" % SM_VERSION,
)

[
    py_wheel(
        name = "selenium-manager-windows-wheel-" + suffix,
        abi = "none",
        classifiers = [
            "Development Status :: 5 - Production/Stable",
            "Intended Audience :: Developers",
            "Operating System :: Microsoft :: Windows",
            "Topic :: Software Development :: Testing",
            "Programming Language :: Python",
        ],
        description_content_type = "text/x-rst",
        description_file = "README.rst",
        distribution = "selenium_manager_windows",
        homepage = "https://www.selenium.dev",
        license = "Apache-2.0",
        platform = tag,
        project_urls = {
            "Source": "https://github.com/SeleniumHQ/selenium/tree/trunk/py/selenium-manager-windows",
            "Issues": "https://github.com/SeleniumHQ/selenium/issues",
        },
        python_requires = ">=3.9",
        python_tag = "py3",
        strip_path_prefixes = ["py/selenium-manager-windows/"],
        summary = "Selenium Manager binary for Windows (ia32 + x64 + arm64)",
        tags = ["release-artifact"],
        version = SM_VERSION,
        visibility = ["//visibility:public"],
        deps = [
            ":lib",
            ":license-wheel",
            # py_wheel packages each dep's DefaultInfo files; py_library keeps data
            # in runfiles, so the binary has to be named here to reach the wheel.
            ":manager-binary",
            ":notice-wheel",
        ],
    )
    for suffix, tag in WHEEL_PLATFORM_TAGS.items()
]

filegroup(
    name = "wheels",
    srcs = [
        "selenium-manager-windows-wheel-" + suffix
        for suffix in WHEEL_PLATFORM_TAGS
    ],
    visibility = ["//visibility:public"],
)
