module Selenium
  module WebDriver
    class BiDi
      class Dispatcher
        @listeners: Hash[String, Listener]

        @mutex: Thread::Mutex

        @last_id: Integer

        @closed: bool

        def initialize: () -> void

        def add_listener: (String event, untyped payload_type) { (untyped) -> void } -> String

        def remove_listener: (String id) -> void

        def receive: (String event, untyped params) -> void

        def close: () -> void
      end
    end
  end
end
