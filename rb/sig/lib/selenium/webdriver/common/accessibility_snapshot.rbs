module Selenium
  module WebDriver
    class AccessibilityNode
      type state = bool | Integer | String

      type remote_value = Hash[String, untyped]

      STATE_ORDER: Array[String]

      attr_reader role: String

      attr_reader name: String

      attr_reader description: String

      attr_reader value: String?

      attr_reader states: Hash[String, state]

      attr_reader element: Element?

      attr_accessor children: Array[AccessibilityNode]

      def initialize: (role: String, name: String, ?description: String, ?value: String?, ?states: Hash[String, state], ?element: Element?, ?children: Array[AccessibilityNode]) -> void

      def to_text: () -> String

      def self.from_remote_value: (remote_value value) { (String shared_id) -> Element } -> AccessibilityNode

      module Wire
        def self?.object_fields: (AccessibilityNode::remote_value value) -> Hash[String, AccessibilityNode::remote_value]

        def self?.string: (AccessibilityNode::remote_value value) -> String

        def self?.state: (AccessibilityNode::remote_value value) -> AccessibilityNode::state
      end

      def lines: (String indent) -> Array[String]

      private

      def line: () -> String

      def state_tokens: () -> String

      def quote: (String text) -> String

      def one_line: (String text) -> String
    end

    class AccessibilitySnapshotter
      include Atoms

      SANDBOX: String

      GLOBAL: String

      SERIALIZATION_OPTIONS: Hash[Symbol, Integer]

      STALE_MESSAGE: String

      @bridge: Remote::Bridge

      @bidi: BiDi

      @preloaded: bool

      @atom: String?

      def initialize: (Remote::Bridge bridge) -> void

      def snapshot: (?Element? root) -> AccessibilityNode

      private

      def ensure_preload: () -> void

      def snapshot_context: (String context, Element? root) -> AccessibilityNode

      def declaration: (String atom, Element? root) -> String

      def call: (String context, String declaration, Array[Hash[Symbol, String]] arguments, ?final: bool) -> AccessibilityNode::remote_value?

      def call_function: (String context, String declaration, Array[Hash[Symbol, String]] arguments, **untyped) -> Hash[String, untyped]

      def stitch: (String context, AccessibilityNode node) -> void

      def frame_context: (String context, Element frame) -> String?

      def contexts: (String top) -> Array[String]

      def frame_unreachable?: (Exception error) -> bool

      def atom: () -> String
    end
  end
end
