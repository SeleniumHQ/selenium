module Selenium
  module WebDriver
    class Alerts
      class Prompt
        attr_reader context: String

        attr_reader window: String

        attr_reader type: String

        attr_reader text: String

        attr_reader default_value: String?

        attr_accessor keys: String?

        def initialize: (untyped event, String window) -> void
      end

      @bridge: untyped

      @requested: Array[true?]

      @handlers: Hash[Object, ^(Alert) -> void]

      @prompts: Hash[String, Prompt]

      @mutex: Thread::Mutex

      def initialize: (Remote::Bridge bridge, Array[Hash[String, untyped]] first_match) -> void

      def add_handler: () { (Alert) -> void } -> Object

      def remove_handler: (Object handle) -> nil

      def bidi_required?: () -> bool

      def handles_prompts?: (Remote::Capabilities capabilities) -> bool

      def subscribe: () -> void

      def current: () -> Prompt

      def manage_exception: (Error::WebDriverError error) -> void

      def forget: (Prompt prompt) -> void

      private

      def manage_prompts_locally: (Hash[String, untyped] candidate) -> true?

      def ignore_prompts: (Hash[String, untyped] candidate) -> true

      def listen_prompt_opened: () -> void

      def listen_prompt_closed: () -> void

      def wait_for_beforeunload_to_close: () -> void

      def user_handler?: () -> bool

      def default_handler: (Alert alert) -> void

      def release_commands: (Prompt prompt, Array[Hash[Symbol, untyped]] waiting) -> void

      def prompt_in: (String? window) -> Prompt?

      def before_bidi_command: (Hash[Symbol, untyped] payload) -> void

      def window_of: (Hash[Symbol, untyped] payload) -> String?

      def context_of: (Hash[Symbol, untyped] payload) -> String?

      def legacy_context_of: (Hash[Symbol, untyped] params) -> String?
    end
  end
end
