module Selenium
  module WebDriver
    class Network
      class HandlerRegistry
        class Handler
          attr_reader intercept: String

          attr_reader block: ^(AuthenticationChallenge) -> untyped

          attr_reader user_context: String?

          def self.new: (String intercept, ^(AuthenticationChallenge) -> untyped block, String? user_context) -> Handler
        end

        @network: untyped

        @session: untyped

        @errors: ListenerErrors

        @handlers: Hash[Object, Handler]

        @subscription: String?

        @mutex: Thread::Mutex

        def initialize: (untyped bridge) -> void

        def add: ((^(AuthenticationChallenge) -> untyped)? block, ?url_patterns: untyped, ?window_handle: String?, ?user_context: String?) -> Object

        def remove: (Object handle) -> nil

        def clear: () -> nil

        def handles: () -> Array[Object]

        def include?: (Object handle) -> bool

        def intercept: (Object handle) -> String?

        private

        def unsubscribe: () -> void

        def dispatch: (BiDi::Protocol::Network::AuthRequiredParameters params) -> void

        def consult: (AuthenticationChallenge challenge, Array[Handler] handlers) -> Hash[Symbol, untyped]

        def answer: (AuthenticationChallenge challenge, Hash[Symbol, untyped] args) -> void
      end
    end
  end
end
