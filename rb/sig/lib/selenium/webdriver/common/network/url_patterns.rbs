module Selenium
  module WebDriver
    class Network
      module UrlPatterns
        type pattern = String | URI::Generic | Hash[Symbol | String, String | Integer]

        RESERVED: Regexp

        SCHEME: Regexp

        INVALID: Hash[Symbol, Regexp]

        def self.build: (pattern | Array[pattern] | nil patterns) -> Array[untyped]?

        private def self.string: (String pattern) -> untyped

        private def self.components: (Hash[Symbol | String, String | Integer] pattern) -> untyped

        private def self.validate_component: (Symbol key, String value) -> void

        private def self.unescaped: (String value) -> String

        private def self.note_glob: (String value) -> void
      end
    end
  end
end
