module Selenium
  module WebDriver
    module Remote
      module BiDiCommands : Bridge
        READINESS_STATE: Hash[String, Symbol]

        @current_window: String?

        def current_window: () -> String

        def install_web_extension: (String path) -> WebExtension

        def uninstall_web_extension: (String id) -> void

        def get: (String url) -> void

        def go_back: () -> void

        def go_forward: () -> void

        def refresh: () -> void

        def switch_to_window: (String name) -> void

        private

        def web_extension_data: (String path) -> untyped

        def readiness_state: () -> Symbol
      end
    end
  end
end
