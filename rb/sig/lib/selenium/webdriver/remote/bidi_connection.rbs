module Selenium
  module WebDriver
    module Remote
      module BiDiConnection : Bridge
        @connection: untyped

        attr_reader bidi: BiDi

        attr_reader connection: untyped

        attr_reader context_tree: BiDi::ContextTree

        attr_reader listener_errors: ListenerErrors

        def quit: () -> void

        def close: () -> void

        private

        def connect_bidi: () -> void

        def execute: (Symbol command, *untyped) -> untyped

        def validated_socket_url: () -> String
      end
    end
  end
end
