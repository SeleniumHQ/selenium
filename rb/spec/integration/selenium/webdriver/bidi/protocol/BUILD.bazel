load("//rb/spec:tests.bzl", "rb_integration_test")

filegroup(
    name = "all_srcs",
    testonly = True,
    srcs = glob(["*.rb"]),
    visibility = ["//rb/spec:__pkg__"],
)

[
    rb_integration_test(
        name = file[:-8],
        srcs = [file],
        bidi = True,
        classic = False,
        data = ["//common/extensions"],
        env = {"SE_BIDI_STRICT": "true"},
        tags = ["exclusive-if-local"],
        deps = [
            "//rb/lib/selenium/webdriver:bidi",
        ],
    )
    for file in glob(["*_spec.rb"])
]
