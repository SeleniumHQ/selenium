# Auto detect text files and perform LF normalization
*        text=auto

*.cs     text diff=csharp
*.java   text diff=java eol=lf
*.html   text diff=html eol=lf
*.css    text eol=lf
*.js     text eol=lf
# The CDDL parser keeps the carriage return in a production name, so a CRLF
# checkout of the overlays in common/bidi makes every type they define unresolvable.
*.cddl   text eol=lf
*.sql    text
*.xml    text

*.csproj text merge=union
*.slnx    text merge=union eol=crlf

*.docx   diff=astextplain

# Any line-ending conversion invalidates the Mozilla signature, so Firefox rejects the add-on as corrupt.
common/extensions/webextensions-selenium-example-signed/** -text
